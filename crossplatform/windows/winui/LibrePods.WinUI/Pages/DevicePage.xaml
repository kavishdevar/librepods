<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LibrePods.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,24">
        <Grid x:Name="DeviceRoot"
              Padding="24"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <!-- Narrow: right column drops below the left (single column) -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RightColumn.(Grid.Row)" Value="1" />
                            <Setter Target="RightColumn.(Grid.Column)" Value="0" />
                            <Setter Target="Col1.Width" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Wide: two side-by-side columns -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <!-- Only two columns when the window is genuinely wide
                                 (the nav pane eats ~260px); below this stay one column. -->
                            <AdaptiveTrigger MinWindowWidth="940" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RightColumn.(Grid.Row)" Value="0" />
                            <Setter Target="RightColumn.(Grid.Column)" Value="1" />
                            <Setter Target="Col1.Width" Value="*" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Header: AirPods image + name/status, full width -->
            <controls:DeviceHeader x:Name="Header" Grid.Row="0" />

            <!-- Transient daemon overlay + nearby-connect prompt -->
            <StackPanel Grid.Row="1" Spacing="16">
                <InfoBar x:Name="OverlayBar"
                         IsOpen="False"
                         IsClosable="True" />
                <InfoBar x:Name="ConnectPromptBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />
            </StackPanel>

            <!-- Responsive card grid: 2 columns wide, 1 column narrow -->
            <Grid x:Name="CardsGrid"
                  Grid.Row="2"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Col0" Width="*" />
                    <ColumnDefinition x:Name="Col1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left column: Battery, Volume, Adaptive Noise -->
                <StackPanel x:Name="LeftColumn"
                            Grid.Row="0" Grid.Column="0"
                            Spacing="16">
                    <controls:BatteryCard x:Name="BatteryCard" />
                    <controls:VolumeCard x:Name="VolumeCard" />
                    <controls:AdaptiveNoiseCard x:Name="AdaptiveNoiseCard" />
                </StackPanel>

                <!-- Right column: Noise Control, Features, Hi-res Mic, Heart Rate -->
                <StackPanel x:Name="RightColumn"
                            Grid.Row="0" Grid.Column="1"
                            Spacing="16">
                    <controls:NoiseControlCard x:Name="NoiseControlCard" />
                    <controls:FeaturesCard x:Name="FeaturesCard" />
                    <controls:MicCard x:Name="MicCard" />
                    <controls:HeartRateCard x:Name="HeartRateCard" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
