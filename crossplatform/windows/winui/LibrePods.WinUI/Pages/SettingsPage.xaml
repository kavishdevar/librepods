<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,24">
        <StackPanel Spacing="16"
                    Padding="24"
                    MaxWidth="640"
                    HorizontalAlignment="Left">

            <TextBlock x:Uid="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar x:Name="SettingsInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsAppearance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsTheme"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ThemeButtons"
                                  MaxColumns="3"
                                  SelectedIndex="0"
                                  SelectionChanged="Theme_SelectionChanged">
                        <RadioButton x:Uid="ThemeSystemRadio" />
                        <RadioButton x:Uid="ThemeLightRadio" />
                        <RadioButton x:Uid="ThemeDarkRadio" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Front-end preference -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsDefaultFrontend" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsDefaultFrontendHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsRefreshBtn" Click="Refresh_Click" />
                        <Button x:Name="SwitchUiButton"
                                x:Uid="SettingsSwitchUiBtn"
                                Click="SwitchUi_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsAbout" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="LibrePods"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsAppDesc"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
