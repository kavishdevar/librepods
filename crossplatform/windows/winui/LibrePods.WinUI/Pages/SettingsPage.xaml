<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,24">
        <StackPanel Spacing="16"
                    Padding="24"
                    HorizontalAlignment="Stretch">

            <TextBlock x:Uid="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar x:Name="SettingsInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsAppearance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsTheme"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ThemeButtons"
                                  MaxColumns="3"
                                  SelectedIndex="0"
                                  SelectionChanged="Theme_SelectionChanged">
                        <RadioButton x:Uid="ThemeSystemRadio" />
                        <RadioButton x:Uid="ThemeLightRadio" />
                        <RadioButton x:Uid="ThemeDarkRadio" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Front-end preference -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsDefaultFrontend" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsDefaultFrontendHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsRefreshBtn" Click="Refresh_Click" />
                        <Button x:Name="SwitchUiButton"
                                x:Uid="SettingsSwitchUiBtn"
                                Click="SwitchUi_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Experimental — heart-rate opt-in. Off by default because AirPods gate
                 the HR stream to Apple hosts; on Windows it does not work. -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsExperimental" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <InfoBar x:Uid="SettingsHrWarning"
                             Severity="Warning" IsOpen="True" IsClosable="False" />
                    <ToggleSwitch x:Name="HeartRateSetting"
                                  x:Uid="SettingsHrToggle"
                                  Toggled="HeartRateSetting_Toggled" />
                </StackPanel>
            </Border>

            <!-- Device info — hidden behind an eye toggle + frosted blur (it carries
                 the serial number). Populated from the 0x1D metadata packet. -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsDeviceInfo" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleButton x:Name="RevealInfo" Grid.Column="1" Padding="8,4"
                                      Checked="RevealInfo_Toggled" Unchecked="RevealInfo_Toggled">
                            <FontIcon Glyph="&#xE7B3;" FontSize="15" />
                        </ToggleButton>
                    </Grid>

                    <!-- Model + firmware are not sensitive — always visible. -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DeviceInfoModel"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DeviceInfoFirmware"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FirmwareText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                        </Grid>
                        <!-- Serial IS sensitive — only this row sits behind the eye + blur. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DeviceInfoSerial"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="SerialText" Text="—" TextWrapping="Wrap" />
                                <Border x:Name="InfoBlur" CornerRadius="4" Margin="-2,-1">
                                    <Border.Background>
                                        <AcrylicBrush TintOpacity="0.55"
                                                      TintLuminosityOpacity="0.9"
                                                      FallbackColor="{ThemeResource CardBackgroundFillColorDefault}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsAbout" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="LibrePods"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsAppDesc"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
