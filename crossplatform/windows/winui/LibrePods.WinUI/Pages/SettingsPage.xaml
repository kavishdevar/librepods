<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,24">
        <StackPanel Spacing="16"
                    Padding="24"
                    MaxWidth="640"
                    HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar x:Name="SettingsInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Theme"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ThemeButtons"
                                  MaxColumns="3"
                                  SelectedIndex="0"
                                  SelectionChanged="Theme_SelectionChanged">
                        <RadioButton Content="System" />
                        <RadioButton Content="Light" />
                        <RadioButton Content="Dark" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Front-end preference -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Default front-end" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Choose which UI the tray's &quot;Open App&quot; launches next time."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh state" Click="Refresh_Click" />
                        <Button x:Name="SwitchUiButton"
                                Content="Switch default UI to iced"
                                Click="SwitchUi_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="LibrePods"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="LibrePods — native Windows client of librepodsd"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
