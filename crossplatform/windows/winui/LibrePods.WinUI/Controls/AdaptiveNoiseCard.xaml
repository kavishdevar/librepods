<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.AdaptiveNoiseCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Adaptive Audio noise strength -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
            <TextBlock x:Uid="AdaptiveNoiseTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="AdaptiveNoiseSubtitle"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="NoiseLowBtn" Click="NoiseLow_Click" />
                <Button x:Uid="NoiseMidBtn" Click="NoiseMid_Click" />
                <Button x:Uid="NoiseHighBtn" Click="NoiseHigh_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
