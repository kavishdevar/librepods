<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.FeaturesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Feature toggles -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="4">
            <TextBlock x:Uid="FeaturesTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <ToggleSwitch x:Name="ConvAwarenessSwitch"
                          x:Uid="FeatureCaSwitch"
                          Toggled="ConvAwareness_Toggled" />
            <ToggleSwitch x:Name="AdaptiveVolumeSwitch"
                          x:Uid="FeatureAvSwitch"
                          Toggled="AdaptiveVolume_Toggled" />
            <ToggleSwitch x:Name="AllowOffSwitch"
                          x:Uid="FeatureAllowOffSwitch"
                          Toggled="AllowOff_Toggled" />
        </StackPanel>
    </Border>
</UserControl>
