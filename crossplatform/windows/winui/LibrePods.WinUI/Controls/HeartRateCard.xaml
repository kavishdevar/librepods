<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.HeartRateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Heart rate (AirPods Pro 3, experimental) -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
            <TextBlock Text="Heart Rate" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="AirPods Pro 3 only — experimental. Drains battery."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" />
            <ToggleSwitch x:Name="HeartRateSwitch"
                          Header="Monitor heart rate"
                          Toggled="HeartRate_Toggled" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock x:Name="HeartRateBpm"
                           Text="—"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource LibrePodsAccentBrush}" />
                <TextBlock Text="bpm"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
