<Window
    x:Class="LibrePods.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LibrePods">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,24">
            <StackPanel Spacing="16"
                        Padding="24"
                        MaxWidth="560"
                        HorizontalAlignment="Stretch">

                <!-- Device header: AirPods image + name/status (LibrePods look) -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="DeviceImage"
                               Grid.Column="0"
                               Width="96" Height="96"
                               Stretch="Uniform"
                               Source="ms-appx:///Assets/airpods.png"
                               VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceName"
                                       Text="LibrePods"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="{ThemeResource TextFillColorDisabledBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText"
                                           Text="Connecting…"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton x:Name="ConnectButton"
                                                 Content="Connect"
                                                 Padding="0"
                                                 Visibility="Collapsed"
                                                 Click="Connect_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Transient daemon overlay notifications -->
                <InfoBar x:Name="OverlayBar"
                         IsOpen="False"
                         IsClosable="True" />

                <!-- Nearby-but-not-connected prompt -->
                <InfoBar x:Name="ConnectPromptBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <!-- Battery -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Battery" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar x:Name="LeftBar" Maximum="100" Value="0" Foreground="{ThemeResource LibrePodsAccentBrush}" />
                                <TextBlock x:Name="LeftText" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar x:Name="RightBar" Maximum="100" Value="0" Foreground="{ThemeResource LibrePodsAccentBrush}" />
                                <TextBlock x:Name="RightText" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Case" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar x:Name="CaseBar" Maximum="100" Value="0" Foreground="{ThemeResource LibrePodsAccentBrush}" />
                                <TextBlock x:Name="CaseText" Text="—" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Noise control -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Noise Control" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <RadioButtons x:Name="AncButtons"
                                      MaxColumns="1"
                                      SelectionChanged="Anc_SelectionChanged">
                            <RadioButton x:Name="AncOff" Content="Off" />
                            <RadioButton Content="Noise Cancellation" />
                            <RadioButton Content="Transparency" />
                            <RadioButton Content="Adaptive" />
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- Volume -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Volume" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Content="&#x2212;" Click="VolDown_Click" MinWidth="44" />
                            <ProgressBar x:Name="VolumeBar" Maximum="100" Value="0" Width="240"
                                         VerticalAlignment="Center" Foreground="{ThemeResource LibrePodsAccentBrush}" />
                            <Button Content="&#x2B;" Click="VolUp_Click" MinWidth="44" />
                            <TextBlock x:Name="VolumeText" Text="—" VerticalAlignment="Center" MinWidth="56" />
                        </StackPanel>
                        <ToggleButton x:Name="MuteToggle" Content="Mute" Click="Mute_Click" />
                    </StackPanel>
                </Border>

                <!-- Feature toggles -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Features" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                        <ToggleSwitch x:Name="ConvAwarenessSwitch"
                                      Header="Conversational Awareness"
                                      Toggled="ConvAwareness_Toggled" />
                        <ToggleSwitch x:Name="AdaptiveVolumeSwitch"
                                      Header="Adaptive Volume"
                                      Toggled="AdaptiveVolume_Toggled" />
                        <ToggleSwitch x:Name="AllowOffSwitch"
                                      Header="Allow &quot;Off&quot; mode"
                                      Toggled="AllowOff_Toggled" />
                    </StackPanel>
                </Border>

                <!-- Adaptive Audio noise strength -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Adaptive Noise" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Only affects Adaptive mode."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Low" Click="NoiseLow_Click" />
                            <Button Content="Medium" Click="NoiseMid_Click" />
                            <Button Content="High" Click="NoiseHigh_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hi-res microphone -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Hi-res Microphone" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="MicStatusText"
                                   Text="Microphone: idle"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch x:Name="MicAutoSwitch"
                                      Header="Auto-enable on recording"
                                      Toggled="MicAuto_Toggled" />
                        <ToggleButton x:Name="MicManualToggle"
                                      Content="Enable hi-res mic now"
                                      Click="MicManual_Click" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Click="Refresh_Click" />
                    <Button x:Name="SwitchUiButton"
                            Content="Switch default UI to iced"
                            Click="SwitchUi_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
